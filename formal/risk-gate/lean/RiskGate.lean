/-!
Lean 4 spec of `execute_signal` (formal/risk-gate/rust/src/lib.rs), itself a port of
`pkg/aster/trader.go` PerpTrader.ExecuteSignal gate + sizing (lines 161-225 @ 37041b5).
Core Lean only (no Mathlib). Nat models u64/u32 exactly for the ranges used;
the Rust side computes in u128, which cannot overflow for u64*u32*u32.
-/

structure Cfg where
  maxPositions : Nat
  maxPositionBps : Nat
  defaultLeverage : Nat
  maxLeverage : Nat
  minNotional : Nat

structure Book where
  active : Nat
  hasPos : Bool
  balance : Nat

structure Sig where
  confBps : Nat
  sizeBps : Nat
  leverage : Nat

inductive Reject | lowConfidence | maxPositions | alreadyOpen | belowMinNotional
  deriving Repr, DecidableEq

structure Sizing where
  sizeBps : Nat
  leverage : Nat
  notional : Nat

def minConfidenceBps : Nat := 6000

def chosenSize (c : Cfg) (s : Sig) : Nat :=
  if 0 < s.sizeBps ∧ s.sizeBps ≤ c.maxPositionBps then s.sizeBps else c.maxPositionBps

/-- Clamp semantics (fix/safety-checks-2026-11): unset (0) → default; above the
operator max → max. The original Go fell back to default only above 125. -/
def chosenLev (c : Cfg) (s : Sig) : Nat :=
  if s.leverage = 0 then c.defaultLeverage
  else if s.leverage ≤ c.maxLeverage then s.leverage else c.maxLeverage

def notional (bal sz lev : Nat) : Nat := bal * sz * lev / 10000

def executeSignal (c : Cfg) (b : Book) (s : Sig) : Except Reject Sizing :=
  if s.confBps < minConfidenceBps then .error .lowConfidence
  else if c.maxPositions ≤ b.active then .error .maxPositions
  else if b.hasPos then .error .alreadyOpen
  else
    if notional b.balance (chosenSize c s) (chosenLev c s) < c.minNotional then .error .belowMinNotional
    else .ok { sizeBps := chosenSize c s, leverage := chosenLev c s,
               notional := notional b.balance (chosenSize c s) (chosenLev c s) }

/-- A config is well-formed when the fallback leverage respects the operator cap. -/
def Cfg.wf (c : Cfg) : Prop := c.defaultLeverage ≤ c.maxLeverage

theorem chosenSize_le (c : Cfg) (s : Sig) : chosenSize c s ≤ c.maxPositionBps := by
  unfold chosenSize; split
  · next h => exact h.2
  · exact Nat.le_refl _

theorem chosenLev_le (c : Cfg) (s : Sig) (hc : c.wf) : chosenLev c s ≤ c.maxLeverage := by
  unfold chosenLev; split
  · exact hc
  · split
    · next h => exact h
    · exact Nat.le_refl _

/-- Exposure bound: whatever the (LLM-produced) signal says, an accepted trade's
notional never exceeds balance × maxPositionBps × maxLeverage / 10000. -/
theorem accepted_exposure_bounded (c : Cfg) (b : Book) (s : Sig) (r : Sizing)
    (hc : c.wf) (h : executeSignal c b s = .ok r) :
    r.notional ≤ b.balance * c.maxPositionBps * c.maxLeverage / 10000 := by
  unfold executeSignal at h
  split at h; · cases h
  split at h; · cases h
  split at h; · cases h
  split at h; · cases h
  cases h
  apply Nat.div_le_div_right
  exact Nat.mul_le_mul (Nat.mul_le_mul_left _ (chosenSize_le c s)) (chosenLev_le c s hc)

/-- Every gate holds on acceptance. -/
theorem accepted_gates (c : Cfg) (b : Book) (s : Sig) (r : Sizing)
    (h : executeSignal c b s = .ok r) :
    minConfidenceBps ≤ s.confBps ∧ b.active < c.maxPositions ∧ b.hasPos = false ∧
    c.minNotional ≤ r.notional := by
  unfold executeSignal at h
  split at h; · cases h
  next h1 =>
  split at h; · cases h
  next h2 =>
  split at h; · cases h
  next h3 =>
  split at h; · cases h
  next h4 =>
  cases h
  refine ⟨Nat.le_of_not_lt h1, Nat.lt_of_not_le h2, ?_, Nat.le_of_not_lt h4⟩
  simpa using h3

/-- Zero balance can never open a position when a positive minimum notional is configured. -/
theorem zero_balance_rejected (c : Cfg) (b : Book) (s : Sig)
    (hb : b.balance = 0) (hm : 0 < c.minNotional) :
    ∀ r, executeSignal c b s ≠ .ok r := by
  intro r h
  have := (accepted_gates c b s r h).2.2.2
  have hz : r.notional = 0 := by
    unfold executeSignal at h
    split at h; · cases h
    split at h; · cases h
    split at h; · cases h
    split at h; · cases h
    cases h; simp [notional, hb]
  omega

/-! Executable spec: third leg of the differential check (Go ↔ Rust ↔ Lean). -/

def statusStr : Except Reject Sizing → String
  | .ok _ => "accepted"
  | .error .lowConfidence => "low_confidence"
  | .error .maxPositions => "max_positions"
  | .error .alreadyOpen => "already_open"
  | .error .belowMinNotional => "below_min_notional"

def main (args : List String) : IO UInt32 := do
  let path := args.headD "../vectors.csv"
  let lines := (← IO.FS.readFile path).splitOn "\n" |>.drop 1 |>.filter (· ≠ "")
  let mut bad := 0
  for line in lines do
    let f := (line.splitOn ",").toArray
    let u (i : Nat) : Nat := (f[i]!).toNat!
    -- vectors.csv layout (generated by the real Go code, pkg/aster TestWriteParityVectors)
    let c : Cfg := { maxPositions := u 2, maxPositionBps := u 5, defaultLeverage := u 7,
                     maxLeverage := u 8, minNotional := u 10 * 10000 }
    let b : Book := { active := u 1, hasPos := u 3 == 1, balance := u 9 * 10000 }
    let s : Sig := { confBps := u 0, sizeBps := u 4, leverage := u 6 }
    if statusStr (executeSignal c b s) != f[11]! then
      bad := bad + 1
      IO.eprintln s!"MISMATCH {line}"
  IO.println s!"lean-spec vectors={lines.length} status_mismatch={bad}"
  return (if bad == 0 then 0 else 1)
